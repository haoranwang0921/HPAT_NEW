# Repository text is normalized to LF so hashes do not depend on the checkout OS.
* text=auto eol=lf

*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.md text eol=lf
*.cff text eol=lf
*.sha256 text eol=lf
SHA256SUMS text eol=lf
Makefile text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.tif binary
*.tiff binary
*.npz binary
*.npy binary
*.pt binary
*.pth binary
*.onnx binary
*.mlmodel binary
*.bin binary
*.tgz binary
*.tar binary
*.gz binary
*.zip binary
